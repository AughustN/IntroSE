# TixHub — local development configuration.
# Copy this file to `.env` in the repository root and fill in the values below:
#   cp .env.example .env
# `.env` is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Where the frontend runs. Used to build links in outgoing e-mail.
APP_URL=http://localhost:3000

# Port the Express API (and the Socket.IO server sharing it) listens on.
# The Vite dev server proxies /api, /socket.io and /uploads to this port.
PORT=4000

NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (REQUIRED) — PostgreSQL 14+
# ---------------------------------------------------------------------------
# Either a local PostgreSQL instance:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tixhub
# or a free hosted branch (the team uses Neon):
#   DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
#
# After setting this, create the schema and load demo data:
#   npm run db:migrate
#   npm run seed
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tixhub

# ---------------------------------------------------------------------------
# Secrets (REQUIRED) — any random string works locally
# ---------------------------------------------------------------------------

# Signs access tokens.
JWT_SECRET=dev-only-change-me

# Keyed hash for auth_events.identifier_hash (FR-055).
AUTH_EVENT_HASH_KEY=dev-only-change-me-too

# ---------------------------------------------------------------------------
# Optional integrations — the app runs without them
# ---------------------------------------------------------------------------

# Google Sign-In (US3). Leave empty to disable the "Continue with Google" button.
# Create an OAuth client ID (Web) in Google Cloud Console with
# http://localhost:3000 as an authorized JavaScript origin, then use the same
# value for both variables.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Transactional e-mail (password reset). Leave RESEND_API_KEY empty and every
# message is printed to the server console instead of being sent.
RESEND_API_KEY=
MAIL_FROM=TixHub <no-reply@tixhub.fit>

# ---------------------------------------------------------------------------
# Seat-hold tuning (feature 003). Optional — the defaults below are applied
# when the variable is absent. Values are in milliseconds unless noted.
# ---------------------------------------------------------------------------

# HOLD_TTL_MS=420000            # 7 min  — hold window from the first held seat
# HOLD_GRACE_MS=420000          # 7 min  — one-time extension during a wallet top-up
# HOLD_ABSOLUTE_MS=840000       # 14 min — ceiling measured from reservation creation
# SEAT_CAP=8                    # tickets one attendee may hold per showtime
# HOLD_SWEEP_INTERVAL_MS=60000  # 1 min  — how often expired holds are released
# HOLD_RATE_LIMIT=30            # hold/release requests per user per window
# HOLD_RATE_WINDOW_MS=10000     # 10 s
