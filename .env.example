# Production configuration template. Copy to .env and fill in all secret values.
# Never commit .env.

APP_URL="https://example.com"
PORT=4000
NODE_ENV="production"

# Neon application database. Use a dedicated test branch for TEST_DATABASE_URL:
# the integration suite truncates its tables between test cases.
DATABASE_URL=REPLACE_WITH_APP_BRANCH_URL
TEST_DATABASE_URL=REPLACE_WITH_TEST_BRANCH_URL

# Demo branch is never connected to. Leave blank to disable the guard.
DEMO_DATABASE_URL=

# Generate long random values for both keys.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
AUTH_EVENT_HASH_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING

# Google OAuth client ID. The VITE_ value is embedded into the frontend build.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Leave RESEND_API_KEY blank to use the development console mailer.
RESEND_API_KEY=
MAIL_FROM="Example App <no-reply@example.com>"

# AI is server-only. The backend appends /chat/completions to OPENAI_BASE_URL.
OPENAI_API_KEY=
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# VNPay Sandbox credentials from the VNPay merchant portal.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_QUERY_URL="https://sandbox.vnpayment.vn/merchant_webapi/api/transaction"
# Browser return page. Register the IPN URL separately in VNPay as:
# https://api.example.com/api/payments/vnpay/ipn
VNPAY_RETURN_URL="https://example.com/vnpay-return"

# Public API used by the built frontend. Rebuild after changing this value.
VITE_API_URL=https://api.example.com
CORS_ORIGINS=https://example.com

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Cloudflare Turnstile & Anti-Bot Protection
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_FAIL_OPEN=false
SERVER_TIMING_SECRET="replace-with-a-long-random-secret-for-timing-tickets"
VITE_TURNSTILE_SITE_KEY=""