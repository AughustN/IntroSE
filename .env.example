# Copy to .env and fill in. Never commit .env — it holds live credentials.

APP_URL=http://localhost:3000
PORT=4000
NODE_ENV=development

# ---------- DATABASE ----------
# Three Neon branches, one per job. They must not be the same branch.
#
#   main   production data. Nothing in this repo points at it.
#   test   TEST_DATABASE_URL. The suite truncates every table between cases.
#   demo   DEMO_DATABASE_URL. Hand-uploaded data, nothing regenerates it.

# The app: dev:server, db:migrate and seed all use this one.
DATABASE_URL=REPLACE_WITH_APP_BRANCH_URL

# vitest, and nothing else. Required to run the suite — there is no fallback to DATABASE_URL,
# because a suite that truncates whichever database happens to be configured is how demo data
# gets destroyed.
TEST_DATABASE_URL=REPLACE_WITH_TEST_BRANCH_URL

# Never connected to. Destructive jobs compare against it and refuse to run when DATABASE_URL
# resolves to the same branch (server/src/db/guards.ts). Leave blank to disable that check.
DEMO_DATABASE_URL=

# ---------- AUTH ----------
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
AUTH_EVENT_HASH_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING

# Google sign-in (US3). Both hold the same client id; the VITE_ copy is what the browser reads.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Empty → ConsoleMailer, which prints mail to the server log instead of sending it.
RESEND_API_KEY=
MAIL_FROM=TixHub <no-reply@tixhub.fit>

# ---------- VNPAY ----------
# Optional at boot so catalog and hold work without gateway credentials. While these are empty,
# POST /api/wallet/topups answers 503 payment_not_configured, so the wallet cannot be funded.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# A frontend page. The redirect is display-only — the wallet is credited by the signed IPN, which
# needs the backend to be publicly reachable (a deployed host or a tunnel; localhost cannot receive it).
VNPAY_RETURN_URL=http://localhost:3000/vnpay-return

# ---------- WALLET (UC-40) ----------
# Defaults shown. VND đồng, integers.
TOPUP_MIN_AMOUNT=5000
TOPUP_MAX_AMOUNT=10000000
WALLET_BALANCE_CAP=20000000
