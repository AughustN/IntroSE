# Secrets — never commit. .env.example is committed instead.
.env
.env.*
!.env.example

# Local database dumps at the repo root. Anchored with a leading slash on purpose:
# a bare `*.sql` would also untrack server/src/db/migrations/*.sql, which is the
# schema and must stay in git.
/*.sql

# Claude
.claude/
.agents/

# IDEs
.vscode/
.idea/
.gemini/

# Spec Kit local state (regenerable, machine-specific)
src/.specify/feature.json
src/.specify/init-options.json
src/.specify/integration.json
src/.specify/integrations/
# Junction at the repo root pointing at src/.specify (lets Claude Code load
# speckit skills from g:\IntroSE). Machine-local, not a real directory.
/.specify
# Assembled submission bundles (a copy of the repo — regenerable)
PA3-Group02/
PA4-Group02/

node_modules/
dist/
build/
coverage/
*.log
.DS_Store
Thumbs.db
*.tmp
*.swp
.codegraph/

# Uploaded avatars (runtime, ADR 0004)
uploads/

